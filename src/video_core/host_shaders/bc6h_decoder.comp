// ConsumeBits: Fully corresponds to CPU Data.consumeBits()
// Implementation uses four 32-bit words (little-endian) to emulate 128-bit shift.
// The function assumes numBits <= 32 in actual usage (matches BC6H usage).
struct BC6H_Data {
    uvec4 words; // words.x == least-significant 32 bits
};

uint bc6h_consumeBits(inout BC6H_Data d, uint MSB, uint LSB) {
    bool reversed = (MSB < LSB);
    if (reversed) {
        uint t = MSB;
        MSB = LSB;
        LSB = t;
    }
    uint numBits = MSB - LSB + 1u;
    if (numBits == 0u) return 0u;

    uint mask = (numBits == 32u) ? 0xFFFFFFFFu : ((1u << numBits) - 1u);

    // Read lower numBits from the 128-bit stream (LSB side)
    uint bits = d.words.x & mask;

    // Shift the 128-bit stream right by numBits
    if (numBits == 32u) {
        d.words.x = d.words.y;
        d.words.y = d.words.z;
        d.words.z = d.words.w;
        d.words.w = 0u;
    } else {
        uint s = numBits;
        uint inv = 32u - s;
        uint x = (d.words.x >> s) | (d.words.y << inv);
        uint y = (d.words.y >> s) | (d.words.z << inv);
        uint z = (d.words.z >> s) | (d.words.w << inv);
        uint w = (d.words.w >> s);
        d.words = uvec4(x, y, z, w);
    }

    if (reversed) {
        uint tmp = 0u;
        for (uint i = 0u; i < numBits; i++) {
            tmp = (tmp << 1u) | (bits & 1u);
            bits >>= 1u;
        }
        bits = tmp;
    }

    return (bits << LSB);
}

uint bc6h_half1() {
    return 0x3C00u;
}

vec4 bc6h_writeColorFromHalfBits(uint r16, uint g16, uint b16) {
    // r16/g16/b16 are half float bit-patterns
    vec2 rg = unpackHalf2x16(r16 | (g16 << 16));
    vec2 ba = unpackHalf2x16(b16 | (uint(bc6h_half1()) << 16));
    return vec4(rg.x, rg.y, ba.x, ba.y);
}

uint bc6h_weight3[8]  = uint[8](0, 9, 18, 27, 37, 46, 55, 64);
uint bc6h_weight4[16] = uint[16](0, 4, 9, 13, 17, 21, 26, 30, 34, 38, 43, 47, 51, 55, 60, 64);

// Interpolates endpoints and applies the final BC6H half-range scaling exactly like CPU.
uvec3 bc6h_interpolate(BC6H_RGBf e0, BC6H_RGBf e1, uint idxValue, int numBits, bool signedFmt)
{
    uint w = (numBits == 3) ? bc6h_weight3[idxValue] : bc6h_weight4[idxValue];
    uint e0w = 64u - w;
    uint e1w = w;

    uvec3 outv = uvec3(0u);

    for (int c = 0; c < 3; c++) {
        int e0c = e0.channel[c];
        int e1c = e1.channel[c];

        if (signedFmt) {
            e0c = bc6h_extendSign(e0c, 16);
            e1c = bc6h_extendSign(e1c, 16);
        }

        int e0Value = e0c * int(e0w);
        int e1Value = e1c * int(e1w);

        int interp = (e0Value + e1Value + 32) >> 6;
        uint tmp = uint(interp);

        if (signedFmt) {
            uint halfBits;
            if ((tmp & 0x80000000u) != 0u) {
                uint mag = (~tmp + 1u);
                halfBits = ((mag * 31u) >> 5) | 0x8000u;
            } else {
                halfBits = (tmp * 31u) >> 5;
            }
            // Don't return -0.0f, normalize it to 0.0f (must be after if-else)
            if (halfBits == 0x8000u) halfBits = 0u;
            outv[c] = (halfBits & 0xFFFFu);
        } else {
            outv[c] = ((tmp * 31u) >> 6) & 0xFFFFu;
        }
    }

    return outv;
}

// BitReader helper: read N LSBs from BC6H_Data stream.
uint bc6h_readBits(inout BC6H_Data d, uint n) {
    if (n == 0u) return 0u;
    return (bc6h_consumeBits(d, n - 1u, 0u) >> 0);
}

// Decodes BC6H mode exactly like CPU code and advances the bitstream.
bool bc6h_decodeMode(inout BC6H_Data d, out BC6H_ModeDesc md, out int modeIndex)
{
    uint mode;
    // Test bit 1 of stream: original used (d.low64 & 0x2) == 0
    if ((d.words.x & 0x2u) == 0u) {
        mode = bc6h_consumeBits(d, 1u, 0u);
    } else {
        mode = bc6h_consumeBits(d, 4u, 0u);
    }

    int idx = bc6h_modeToIndex(mode);
    if (idx < 0) {
        return false;
    }

    modeIndex = idx;
    md = BC6H_blockDescs[modeIndex][0].modeDesc;
    return true;
}

int bc6h_subsetIndex(BC6H_ModeDesc md, uint partitionIdx, int texel) {
    if (md.partitionCount == 1) return 0;
    return int(BC6H_PartitionTable2[partitionIdx][texel]);
}

int bc6h_anchorIndex(BC6H_ModeDesc md, uint partitionIdx, int subset) {
    if (md.partitionCount == 1) return 0;
    // BC6H: subset 0 anchor is always texel 0, subset 1 anchor from table
    return (subset == 0) ? 0 : int(BC6H_AnchorTable2[partitionIdx] & 0xFu);
}

// Parses endpoints/partition exactly like the CPU blockDesc loop.
// IMPORTANT: 'd' must already have consumed the mode bits.
void bc6h_parseBlock(inout BC6H_Data d,
                     bool signedFmt,
                     int modeIndex,
                     out BC6H_ModeDesc md,
                     out BC6H_RGBf e[4],
                     out uint partitionIdx)
{
    md = BC6H_blockDescs[modeIndex][0].modeDesc;

    // Initialize endpoints
    for (int ep = 0; ep < 4; ep++) {
        e[ep].isSigned = signedFmt;
        for (int c = 0; c < 3; c++) {
            e[ep].channel[c] = 0;
            e[ep].sizeBits[c] = 0;
        }
    }

    partitionIdx = 0u;

    // CPU sets endpoint bit sizes from modeDesc before decoding values.
    // e0 sizes = endpointBits
    for (int c = 0; c < 3; c++) {
        e[0].sizeBits[c] = md.endpointBits;
        if (md.hasDelta) {
            e[1].sizeBits[c] = md.deltaBits[c];
            e[2].sizeBits[c] = md.deltaBits[c];
            e[3].sizeBits[c] = md.deltaBits[c];
        } else {
            e[1].sizeBits[c] = md.endpointBits;
            e[2].sizeBits[c] = md.endpointBits;
            e[3].sizeBits[c] = md.endpointBits;
        }
    }

    // Consume fields as described by the table, but DO NOT consume bits for Mode desc.
    for (int i = 0; i < 26; i++) {
        BC6H_BlockDesc bd = BC6H_blockDescs[modeIndex][i];
        if (bd.type == BC6H_End) break;

        if (bd.type == BC6H_Mode) {
            // No bit consumption here (CPU already consumed mode bits earlier).
            continue;
        }

        uint bits = bc6h_consumeBits(d, uint(bd.MSB), uint(bd.LSB));

        if (bd.type == BC6H_Partition) {
            // Partition is a 5-bit value located at [4:0] in the returned 'bits' (LSB=0).
            partitionIdx |= bits;
        } else {
            // Endpoint field
            int ep = bd.type;      // EP0..EP3
            int ch = bd.channel;   // R/G/B
            e[ep].channel[ch] |= int(bits);
        }
    }

    // Sign extension rules must match CPU:
    // if signed: sign-extend all used endpoints
    // else if hasDelta: sign-extend endpoints 1..(partitionCount*2-1) only (delta endpoints)
    int usedEndpoints = md.partitionCount * 2;
    if (signedFmt) {
        for (int ep = 0; ep < usedEndpoints; ep++) {
            bc6h_rgbf_extendSign(e[ep]);
        }
    } else if (md.hasDelta) {
        for (int ep = 1; ep < usedEndpoints; ep++) {
            bc6h_rgbf_extendSign(e[ep]);
        }
    }

    // Resolve deltas exactly like CPU:
    // for ep=1..usedEndpoints-1: e[ep] = e0 + delta(ep)
    if (md.hasDelta) {
        for (int ep = 1; ep < usedEndpoints; ep++) {
            bc6h_rgbf_resolveDelta(e[ep], e[0]);
        }
    }

    // Unquantize only used endpoints
    for (int ep = 0; ep < usedEndpoints; ep++) {
        bc6h_unquantize(e[ep]);
    }
}

// -------------------- main --------------------
void main() {
    uint bx = gl_GlobalInvocationID.x;
    uint by = gl_GlobalInvocationID.y;
    uint layer = gl_GlobalInvocationID.z;
    if (bx >= num_blocks_x || by >= num_blocks_y) {
        return;
    }

    ivec2 base_px = ivec2(int(bx * 4u), int(by * 4u));
    int layer_i = int(layer);
    ivec3 img_size = imageSize(dest_image);

    uvec3 pos = uvec3(bx, by, layer);
    uint byte_address = ComputeBlockByteAddress(pos);

    // ---------------------------------------------------------
    // Bounds check
    // ---------------------------------------------------------
    // BC6H blocks are 16 bytes. Check if reading this block would exceed the buffer size.
    if (byte_address + 16u > input_size_bytes) {
        if (gl_LocalInvocationIndex == 0u) {
            for (uint y = 0u; y < 4u; y++) {
                for (uint x = 0u; x < 4u; x++) {
                    ivec3 p = ivec3(base_px + ivec2(int(x), int(y)), layer_i);
                    if (p.x < img_size.x && p.y < img_size.y && p.z < img_size.z) {
                        imageStore(dest_image, p, vec4(0.0, 0.0, 0.0, 0.0));
                    }
                }
            }
        }
        return;
    }
    // ---------------------------------------------------------

    uvec4 w = LoadBlock128(byte_address);

    bool signedFmt = (is_signed != 0u);

    // Prepare 128-bit stream as four 32-bit words (little-endian)
    BC6H_Data d;
    d.words = uvec4(w.x, w.y, w.z, w.w);

    BC6H_ModeDesc md;
    int modeIndex;
    if (!bc6h_decodeMode(d, md, modeIndex)) {
        for (uint y = 0u; y < 4u; y++) {
            for (uint x = 0u; x < 4u; x++) {
                ivec3 p = ivec3(base_px + ivec2(int(x), int(y)), layer_i);
                if (p.x < img_size.x && p.y < img_size.y && p.z < img_size.z) {
                    imageStore(dest_image, p, vec4(0.0, 0.0, 0.0, 1.0));
                }
            }
        }
        return;
    }

    // ---- Parse endpoints/partition from the remaining bitstream (d continues) ----
    BC6H_RGBf e[4];
    uint partitionIdx;
    bc6h_parseBlock(d, signedFmt, modeIndex, md, e, partitionIdx);
    // Note: bc6h_parseBlock() already unquantizes used endpoints, matching CPU.

    // ---- Index params ----
    int indexBits = (md.partitionCount == 2) ? 3 : 4;

    // ---- Decode 4x4 texels ----
    for (int y = 0; y < 4; y++) {
        for (int x = 0; x < 4; x++) {
            int texel = x + y * 4;

            uint idxValue;
            int numBits;
            int firstEndpoint = 0;
            bool isAnchor = false;

            if (md.partitionCount == 1) {
                numBits = 4;
                isAnchor = (texel == 0);
            } else {
                numBits = 3;
                isAnchor = (texel == 0) || (texel == int(BC6H_AnchorTable2[partitionIdx]));
                firstEndpoint = int(BC6H_PartitionTable2[partitionIdx][texel]) * 2;
            }

            // Read index bits: CPU does consumeBits(numBits - isAnchor - 1, 0)
            // which reads (numBits - isAnchor - 1) - 0 + 1 = numBits - isAnchor bits
            // bc6h_readBits(d, n) calls bc6h_consumeBits(d, n-1, 0) which reads n bits
            // So we need to call bc6h_readBits(d, numBits - isAnchor)
            uint bitsToRead = uint(numBits - (isAnchor ? 1 : 0));
            idxValue = bc6h_readBits(d, bitsToRead);

            // Check bounds after consuming index bits to match CPU behavior
            ivec3 store_pos = ivec3(base_px + ivec2(int(x), int(y)), layer_i);
            if (store_pos.x >= img_size.x || store_pos.y >= img_size.y || store_pos.z >= img_size.z) {
                continue;
            }

            uvec3 rgb16 = bc6h_interpolate(e[firstEndpoint + 0],
                                           e[firstEndpoint + 1],
                                           idxValue,
                                           numBits,
                                           signedFmt);

            vec4 col = bc6h_writeColorFromHalfBits(rgb16.x, rgb16.y, rgb16.z);

            // Clamp to valid color range before writing to prevent out-of-range values.
            col = clamp(col, 0.0, 1.0);

            imageStore(dest_image, store_pos, col);
        }
    }
}
