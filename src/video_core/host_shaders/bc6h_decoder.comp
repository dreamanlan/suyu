int bc6h_modeToIndex(uint mode) {
    if (mode <= 3u) return int(mode);
    else if ((mode & 2u) != 0u) {
        if (mode <= 18u) return int(mode / 2u) + 1 + int(mode & 1u);
        else if (mode == 22u || mode == 26u || mode == 30u) return int(mode / 4u) + 6;
    }
    return -1;
}

