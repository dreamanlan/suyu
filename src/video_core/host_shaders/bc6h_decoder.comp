// ---------------- BC6H core (ported from CPU) ----------------

int bc6h_extendSign(int val, int sizeBits) {
    int mask = 1 << (sizeBits - 1);
    return (val ^ mask) - mask;
}

struct BC6H_RGBf {
    int channel[3];
    int sizeBits[3];
    bool isSigned;
};

void bc6h_rgbf_extendSign(inout BC6H_RGBf v) {
    for (int i = 0; i < 3; i++) {
        v.channel[i] = bc6h_extendSign(v.channel[i], v.sizeBits[i]);
    }
}

void bc6h_rgbf_resolveDelta(inout BC6H_RGBf delta, BC6H_RGBf base) {
    for (int i = 0; i < 3; i++) {
        delta.sizeBits[i] = base.sizeBits[i];
        delta.channel[i] = (base.channel[i] + delta.channel[i]) & ((1 << base.sizeBits[i]) - 1);
    }
    if (delta.isSigned) {
        bc6h_rgbf_extendSign(delta);
    }
}

void bc6h_unquantizeUnsigned(inout BC6H_RGBf v) {
    for (int i = 0; i < 3; i++) {
        if (v.sizeBits[i] >= 15 || v.channel[i] == 0) {
            // keep
        } else if (v.channel[i] == ((1 << v.sizeBits[i]) - 1)) {
            v.channel[i] = 0xFFFF;
        } else {
            uint tmp = uint(v.channel[i]);
            v.channel[i] = int(((tmp << 16) + 0x8000u) >> uint(v.sizeBits[i]));
        }
        v.sizeBits[i] = 16;
    }
}

void bc6h_unquantizeSigned(inout BC6H_RGBf v) {
    for (int i = 0; i < 3; i++) {
        if (v.sizeBits[i] >= 16 || v.channel[i] == 0) {
            v.sizeBits[i] = 16;
            continue;
        }
        int value = bc6h_extendSign(int(v.channel[i] & 0xFFFF), 16);
        int result = value;
        bool signBit = value < 0;
        if (signBit) {
            value = -value;
        }

        if (value >= ((1 << (v.sizeBits[i] - 1)) - 1)) {
            result = 0x7FFF;
        } else {
            result = (((value << 15) + 0x4000) >> (v.sizeBits[i] - 1));
        }
        if (signBit) {
            result = -result;
        }

        v.channel[i] = result & 0xFFFF;
        v.sizeBits[i] = 16;
    }
}

void bc6h_unquantize(inout BC6H_RGBf v) {
    if (v.isSigned) {
        bc6h_unquantizeSigned(v);
    } else {
        bc6h_unquantizeUnsigned(v);
    }
}

