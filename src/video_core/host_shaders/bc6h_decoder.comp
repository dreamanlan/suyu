layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, std430) readonly restrict buffer InputBuffer {
    uint input_data[];
};

layout(binding = 1, rgba16f) uniform writeonly image2DArray dest_image;

layout(push_constant) uniform PushConstants {
    uint num_blocks_x;
    uint num_blocks_y;
    uint layer_stride;       // bytes per layer
    uint block_size;
    uint x_shift;
    uint block_height;
    uint block_height_mask;
    uint is_signed;

    uint input_size_bytes;       // readable input size from the bound buffer region
};

const uint GOB_SIZE_X_SHIFT = 6;
const uint GOB_SIZE_Y_SHIFT = 3;
const uint GOB_SIZE_SHIFT   = GOB_SIZE_X_SHIFT + GOB_SIZE_Y_SHIFT;

// BC6H block is 16 bytes.
const uint BYTES_PER_BLOCK_LOG2 = 4;
const uint SWIZZLE_X_BITS = 0x12Fu;
const uint SWIZZLE_Y_BITS = 0x0D0u;

uint pdep32(uint value, uint mask) {
    uint result = 0u;
    uint src_bit_index = 0u;
    for (uint dst_bit = 0u; dst_bit < 32u; ++dst_bit) {
        uint dst_mask = 1u << dst_bit;
        if ((mask & dst_mask) != 0u) {
            uint src_mask = 1u << src_bit_index;
            if ((value & src_mask) != 0u) {
                result |= dst_mask;
            }
            src_bit_index++;
        }
    }
    return result;
}

uint SwizzleOffset(uvec2 pos_bytes_xy) {
    uint x_bytes = pos_bytes_xy.x;
    uint y_rows = pos_bytes_xy.y;
    uint swizzled_x = pdep32(x_bytes, SWIZZLE_X_BITS);
    uint swizzled_y = pdep32(y_rows, SWIZZLE_Y_BITS);
    return swizzled_x | swizzled_y;
}

uint ComputeBlockByteAddress(uvec3 block_id) {
    uvec3 pos = block_id;
    pos.x <<= BYTES_PER_BLOCK_LOG2;

    const uint swizzle = SwizzleOffset(pos.xy);
    const uint block_y = pos.y >> GOB_SIZE_Y_SHIFT;

    uint offset = 0u;
    offset += pos.z * layer_stride;
    offset += (block_y >> block_height) * block_size;
    offset += (block_y & block_height_mask) << GOB_SIZE_SHIFT;
    offset += (pos.x >> GOB_SIZE_X_SHIFT) << x_shift;
    offset += swizzle;
    return offset;
}

uvec4 LoadBlock128(uint byte_address) {
    uint w = byte_address >> 2;
    return uvec4(input_data[w + 0], input_data[w + 1], input_data[w + 2], input_data[w + 3]);
}

