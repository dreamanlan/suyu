// ------------ BC7 core (ported from CPU) ------------

struct Bitfield { int offset; int count; };

Bitfield Then(Bitfield bf, int bits) { return Bitfield(bf.offset + bf.count, bits); }

struct Mode {
    int IDX; int NS; int PB; int RB; int ISB; int CB; int AB; int EPB; int SPB; int IB; int IBC; int IB2;
};

const Mode Modes[9] = Mode[9](
